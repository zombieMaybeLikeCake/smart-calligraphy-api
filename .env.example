# 複製這份成 .env（.env 本身不進 git），docker compose 會自動讀取。
#
# 給面試官/展示用的 API Key。留空 = /predict/* 完全不驗證，只適合純本機開發。
# 服務一旦透過 frp 掛到公網，這個一定要設，不然任何人都能打你的 GPU。
API_KEY=

# 每個來源 IP 對 /predict/* 的速率限制，slowapi 格式。
# 經 frp tcp 模式轉發時「每 IP」會失真（見 app/config.py 裡的說明），
# 但先設著總比完全不設好。
RATE_LIMIT_PREDICT=10/minute

# /synthesize/* 一次請求可能對每個字各跑一次推論（見 app/main.py 的
# MAX_SYNTHESIZE_CHARS），比 /predict/* 重，限制設得更緊。
RATE_LIMIT_SYNTHESIZE=5/minute
